# ==============================================================================
# AI SOCIAL MEDIA & COMMUNICATIONS MASTER AGENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

# --- TELEGRAM BOT ---
# Obtain from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Your Telegram User ID (optional security lock - bot will only respond to you)
TELEGRAM_ALLOWED_USER_ID=

# --- AI REASONING ENGINE ---
# LLM Provider: "gemini" or "openrouter"
LLM_PROVIDER=openrouter
# OpenRouter API Key
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Google Gemini API Key (if LLM_PROVIDER=gemini)
GEMINI_API_KEY=
# LLM Model (e.g., google/gemini-2.5-flash or anthropic/claude-3.5-sonnet)
LLM_MODEL=google/gemini-2.5-flash

# --- FACEBOOK PAGES ---
# Graph API Page ID and Access Token
FACEBOOK_PAGE_ID=your_facebook_page_id_here
FACEBOOK_ACCESS_TOKEN=your_facebook_access_token_here
FACEBOOK_API_VERSION=v19.0

# --- INSTAGRAM BUSINESS ---
# Instagram Business Account ID and Meta Graph Access Token
INSTAGRAM_ACCOUNT_ID=your_instagram_account_id_here
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token_here
INSTAGRAM_API_VERSION=v19.0

# --- WHATSAPP ---
# Mode: "cloud_api" or "linked_device"
WHATSAPP_MODE=cloud_api
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here
WHATSAPP_API_VERSION=v20.0
WHATSAPP_RECIPIENT_PHONE=your_recipient_phone_here
WHATSAPP_BRIDGE_URL=http://127.0.0.1:3001

# --- GMAIL (IMAP/SMTP) ---
GMAIL_EMAIL=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_google_app_password
GMAIL_CLIENT_SECRET_FILE=

# --- SUBSTACK ---
SUBSTACK_SUBDOMAIN=your_substack_subdomain
SUBSTACK_COOKIE_SID=

# --- N8N BRIDGE ---
N8N_BASE_URL=https://your-n8n-instance.onrender.com/api/v1
N8N_API_KEY=your_n8n_api_key_here
